@article{beroho_analysis_2020,
	title = {Analysis and prediction of climate forecasts in {Northern} {Morocco}: application of multilevel linear mixed effects models using {R} software},
	volume = {6},
	issn = {24058440},
	shorttitle = {Analysis and prediction of climate forecasts in {Northern} {Morocco}},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S240584402031937X},
	doi = {10.1016/j.heliyon.2020.e05094},
	abstract = {For many years, the application of mixed-effects modeling has received much attention for predicting scenarios in the ﬁelds of theoretical and applied sciences. In this study, a “new” Multilevel Linear Mixed-Effects (LME) model is proposed to analyze and predict multiply-nested and hierarchical data. Temperature and rainfall observation were carried out successively between 1979-2014 and 1984–2018; and the data input was organized on monthly basis for each year. Besides, a daily observation was made for “Dar Chaoui” zone of Northern Morocco. However, we chose in the ﬁrst time a simple linear regression model, but the estimation has been just for ﬁxed effects and ignoring the random effect. On the other hand, in multilevel linear mixed effects models, once the model has been formulated, methods are needed to estimate the model parameters. In this section, we ﬁrst deal with the joint estimation of the ﬁxed effects (β), random effects (ui) and then with estimation of the variance parameters (γ, ρ and σ2). The study revealed that the predicted values are very close to the real value. Besides, this model is capable of modelling the error, ﬁxed and random parts of the sample. Moreover, in this range, the results showed that there is three standard deviations measures for ﬁxed and random effects, also the variance measure, which demonstrate us a great prediction. In conclusion, this model gives a decisive precision of results that can be exploited in studies for forecast of water balance and/or soil erosion. These results can also be used to inhibit the risk of erosion with possible arrangements for the environment and human security.},
	language = {en},
	number = {10},
	urldate = {2026-04-21},
	journal = {Heliyon},
	author = {Beroho, Mohamed and Briak, Hamza and El Halimi, Rachid and Ouallali, Abdessalam and Boulahfa, Imane and Mrabet, Rachid and Kebede, Fassil and Aboumaria, Khadija},
	month = oct,
	year = {2020},
	pages = {e05094},
	file = {PDF:/home/simon/Zotero/storage/UBWG22P4/Beroho et al. - 2020 - Analysis and prediction of climate forecasts in Northern Morocco application of multilevel linear m.pdf:application/pdf},
}

